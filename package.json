{
  "name": "illuminator",
  "productName": "ILLUMinator",
  "version": "0.5.8",
  "description": "Open, refocus and animate Lytro ILLUM and first generation light field photographs",
  "license": "PolyForm-Shield-1.0.0",
  "author": "AbstractPolygon, LLC",
  "homepage": "https://abstractpolygon.com",
  "desktopName": "illuminator.desktop",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve.mjs",
    "build:web": "node scripts/build-web.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "render": "node scripts/lfr-render.mjs",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.illuminator.app",
    "productName": "ILLUMinator",
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "lfr",
        "name": "Lytro ILLUM photo"
      },
      {
        "ext": "lfp",
        "name": "Lytro light field photo"
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "maintainer": "AbstractPolygon, LLC",
      "synopsis": "Lytro light field photo editor",
      "syncDesktopName": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "dmg": {
      "title": "ILLUMinator ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  }
}
